# Copy this file to .env.local and fill in your own values.
# See /app/README.md for full setup instructions.

# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional: used only for local display, real secrets live in Supabase Edge Function env ---
# Everything below this line is NOT read by the frontend. It documents the
# secrets you'll add to your Supabase project (Project Settings -> Edge Functions -> Secrets)
# so the Edge Functions in /app/supabase/functions can use them.
#
# ANTHROPIC_API_KEY=              # powers the AI assistant (supabase/functions/ai-assistant)
# GOOGLE_CLIENT_ID=               # Google Cloud OAuth client (Calendar + Gmail)
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=            # Azure AD app registration (Outlook Calendar + Mail)
# MICROSOFT_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=            # e.g. https://your-project-ref.supabase.co/functions/v1
